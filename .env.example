NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
WEB_APP_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
# Use your local MongoDB by default. To use Docker MongoDB, set MONGODB_URI to port 27018
# and run: docker compose --profile docker-mongo up -d
MONGODB_HOST_PORT=27018
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MONGODB_URI=mongodb://localhost:27017/your-database-name
REDIS_HOST=localhost
REDIS_PORT=6380
# Local MinIO provides S3-compatible storage without an AWS account or usage fees.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=novera-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
DOCUMENT_MAX_SIZE_MB=10
# Keep the local assistant enabled for development. No external AI request is made.
AI_PROVIDER=mock
# Leave empty for local testing. Add a provider key only after an explicit product decision.
AI_API_KEY=
